      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "qdrant-cred-01",
          "name": "qdrantAuth"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const { query, topK = 5, filter, model } = $json.body;\n\nreturn [{ json: { query, topK, filter, model: model || 'nvidia/nv-embedqa-e5-v5' } }];"
      },
