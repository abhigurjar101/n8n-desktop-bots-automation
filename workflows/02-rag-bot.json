        250,
        200
      ],
      "webhookId": "rag-ingest"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "2",
      "name": "Webhook - Query RAG",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        500
      ],
      "webhookId": "rag-query"
    },
    {
      "parameters": {
        "functionCode": "const { files, directory, chunkSize, chunkOverlap } = $json.body;\n\nlet filePaths = [];\n\nif (files && Array.isArray(files)) {\n  filePaths = files;\n} else if (directory) {\n  const fs = require('fs');\n  const path = require('path');\n  \n  function walkDir(dir) {\n    const entries = fs.readdirSync(dir, { withFileTypes: true });\n    for (const entry of entries) {\n      const fullPath = path.join(dir, entry.name);\n      if (entry.isDirectory()) {\n        walkDir(fullPath);\n      } else if (\\.md$|\\.txt$|\\.pdf$|\\.js$|\\.ts$|\\.py$|\\.json$|\\.yaml$|\\.yml$|\\.html$|\\.css$|\\.mdx$/.test(entry.name)) {\n        filePaths.push(fullPath);\n      }\n    }\n  }\n  \n  walkDir(directory);\n}\n\nreturn filePaths.map(fp => ({ json: { filePath: fp } }));"
      },
      "id": "3",
      "name": "Resolve File Paths",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        500,
        200
      ]
    },
    {
      "parameters": {
        "functionCode": "const fs = require('fs');\nconst path = require('path');\n\nconst { filePath } = $json;\nconst ext = path.extname(filePath).toLowerCase();\n\nlet content = '';\n\ntry {\n  if (ext === '.pdf') {\n    const pdf = require('pdf-parse');\n    const buffer = fs.readFileSync(filePath);\n    const data = await pdf(buffer);\n    content = data.text;\n  } else {\n    content = fs.readFileSync(filePath, 'utf-8');\n  }\n} catch (e) {\n  return [{ json: { filePath, error: e.message, content: '' } }];\n}\n\nreturn [{ json: { filePath, content, ext } }];"
      },
      "id": "4",
      "name": "Read File Content",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        750,
        200
      ]
    },
    {
      "parameters": {
        "functionCode": "const { content, chunkSize = 1000, chunkOverlap = 200 } = $json;\n\nif (!content || content.trim().length === 0) {\n  return [{ json: { chunks: [], filePath: $json.filePath } }];\n}\n\nconst chunks = [];\nlet start = 0;\n\nwhile (start < content.length) {\n  const end = Math.min(start + chunkSize, content.length);\n  let chunk = content.slice(start, end);\n  \n  if (end < content.length) {\n    const lastNewline = chunk.lastIndexOf('\\n');\n    const lastSpace = chunk.lastIndexOf(' ');\n    const breakPoint = Math.max(lastNewline, lastSpace);\n    if (breakPoint > chunkSize * 0.5) {\n      chunk = chunk.slice(0, breakPoint);\n      end = start + breakPoint;\n    }\n  }\n  \n  chunks.push({\n    text: chunk.trim(),\n    startIndex: start,\n    endIndex: end,\n    filePath: $json.filePath\n  });\n  \n  start = end - chunkOverlap;\n  if (start >= content.length) break;\n}\n\nreturn chunks.map(c => ({ json: c }));"
      },
      "id": "5",
      "name": "Chunk Text",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "model": "nvidia/nv-embedqa-e5-v5",
        "input": "={{ $json.text }}",
        "options": {}
      },
      "id": "6",
      "name": "OpenAI - Generate Embeddings",
      "type": "n8n-nodes-base.openAi",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "typeVersion": 1.2,
      "position": [
        1250,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "nvidia-cred-01",
          "name": "nvidiaApi"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const { data, filePath, startIndex, endIndex } = $json;\n\nconst embedding = data[0].embedding;\n\nconst vectorData = {\n  id: `${filePath}_${startIndex}_${endIndex}_${Date.now()}`, \n  vector: embedding,\n  payload: {\n    text: $json.text,\n    filePath,\n    startIndex,\n    endIndex,\n    metadata: {\n      source: filePath,\n      chunkIndex: Math.floor(startIndex / 1000),\n      timestamp: new Date().toISOString()\n    }\n  }\n};\n\nreturn [{ json: vectorData }];"
      },
      "id": "7",
      "name": "Prepare Vector Record",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1500,
        200
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:6333/collections/n8n_rag/points",
        "method": "PUT",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify([$json]) }}",
        "headerParametersJson": "={\n  \"Content-Type\": \"application/json\",\n  \"api-key\": \"{{ $credentials.qdrantApiKey }}\"\n}"
      },
      "id": "8",
      "name": "Qdrant - Upsert Vectors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1750,
