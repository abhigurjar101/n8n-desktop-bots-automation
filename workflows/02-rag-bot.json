    {
      "parameters": {
        "url": "http://localhost:6333/collections/n8n_rag/points/search",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"vector\": {{ JSON.stringify($json.data[0].embedding) }},\n  \"limit\": {{ $json.topK }},\n  \"with_payload\": true,\n  \"with_vector\": false\n}",
        "headerParametersJson": "={\n  \"Content-Type\": \"application/json\",\n  \"api-key\": \"{{ $credentials.qdrantApiKey }}\"\n}"
      },
      "id": "11",
      "name": "Qdrant - Search Vectors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1000,
