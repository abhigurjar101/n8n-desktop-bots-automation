    {
      "parameters": {
        "functionCode": "const { result, query } = $json;\n\nconst contexts = result.map((r, i) => ({\n  rank: i + 1,\n  score: r.score,\n  text: r.payload.text,\n  source: r.payload.filePath,\n  metadata: r.payload.metadata\n})).filter(r => r.score > 0.5);\n\nconst contextText = contexts.map(c => `\n[Source ${c.rank} | Score: ${c.score.toFixed(3)} | File: ${c.source}]\n${c.text}`).join('\\n---\\n');\n\nconst systemPrompt = `You are a helpful AI assistant that answers questions based on the provided context. \n\nGuidelines:\n1. Only use information from the provided context\n2. If the context doesn't contain the answer, say so clearly\n3. Cite sources using [Source X] format\n4. Be concise but thorough\n5. If uncertain, express uncertainty\n\nContext:\n${contextText}`;\n\nreturn [{ json: { systemPrompt, query, contexts, model: 'nvidia/nemotron-3-ultra-550b-a55b', temperature: 0.1 } }];"
      },
      "id": "12",
      "name": "Build RAG Prompt",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1250,
        500
      ]
    },
    {
      "parameters": {
        "temperature": "={{ $json.temperature }}",
        "maxTokens": 3000,
        "options": {},
        "resource": "chat",
        "operation": "complete",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "={{ $json.systemPrompt }}"
            },
            {
              "role": "user",
              "content": "={{ $json.query }}"
            }
          ]
        },
        "chatModel": "={{ $json.model }}"
      },
      "id": "13",
      "name": "OpenAI - RAG Answer",
      "type": "n8n-nodes-base.openAi",
      "baseUrl": "https://integrate.api.nvidia.com/v1",
      "typeVersion": 1.2,
      "position": [
        1500,
        500
      ],
      "credentials": {
        "openAiApi": {
          "id": "nvidia-cred-01",
          "name": "nvidiaApi"
        }
      }
    },
