      "parameters": {
        "functionCode": "const answer = $json.choices[0].message.content;\nconst { contexts, query } = $json;\n\nreturn [{ json: {\n  success: true,\n  query,\n  answer,\n  sources: contexts.map(c => ({\n    file: c.source,\n    score: c.score,\n    preview: c.text.substring(0, 200)\n  })),\n  usage: $json.usage\n} }];"
      },
