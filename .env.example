# n8n Desktop Bots Suite Configuration

# n8n server endpoint
N8N_BASE_URL=http://localhost:5678

# Optional: n8n API Key (required only for n8n Manager Bot and automated workflow importing)
N8N_API_KEY=

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333

# NVIDIA API Key (configured in n8n credentials for Nemotron 3 Ultra)
NVIDIA_API_KEY=

# Control Center Web UI Port
WEB_PORT=8000
WEB_HOST=0.0.0.0
